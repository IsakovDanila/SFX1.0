# Скопируйте этот файл в .env и заполните своими значениями.
#   Windows:  copy .env.example .env
#   Mac/Linux: cp .env.example .env
# .env добавлен в .gitignore — в git он НЕ попадёт.

# --- HuggingFace: ускоряет скачивание весов CLAP, снимает rate limit ---
# Токен типа "Read": https://huggingface.co/settings/tokens
HF_TOKEN=hf_вставьте_свой_токен

# --- CLAP ---
SFX_USE_CLAP=1
# Путь к локальным весам (иначе пакет скачает ~1.9 ГБ сам)
# SFX_CLAP_CKPT=C:\Users\Вы\.cache\sfx-clap\630k-audioset-best.pt
# Работать без сети (нужны локальные веса и токенизатор)
# SFX_CLAP_OFFLINE=1
# 0 = 630k-best, 1 = 630k-audioset-best
SFX_CLAP_MODEL_ID=1

# --- Качество поиска ---
# Калибровка процентов совпадения: границы косинуса
# SFX_CLAP_CALIB=0.20,0.55
# Порог «ничего похожего не найдено»
# SFX_CLAP_MIN_COS=0.18
# Автотеги при сканировании (0 = выключить)
# SFX_AUTOTAG_TOPK=3
# SFX_AUTOTAG_THRESHOLD=0.12
